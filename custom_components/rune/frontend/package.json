{
  "name": "rune-frontend",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "RUNE Home Assistant panel — Lit SPA bundled for the iframe target.",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && pnpm lint && pnpm format:check && vite build --config vite.spa.config.ts && vite build --config vite.shim.config.ts",
    "build:spa": "vite build --config vite.spa.config.ts",
    "build:shim": "vite build --config vite.shim.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "knip": "knip",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium --with-deps",
    "ci": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm knip && pnpm build && pnpm test:e2e"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@shoelace-style/shoelace": "^2.20.1",
    "@tabler/icons-webfont": "^3.46.0",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.0.0",
    "knip": "^6.32.0",
    "oxlint": "^1.78.0",
    "prettier": "^3.9.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.0",
    "vite-plugin-singlefile": "^2.0.0"
  },
  "packageManager": "pnpm@11.16.0"
}
