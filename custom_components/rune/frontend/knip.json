{
  "$schema": "https://unpkg.com/knip@6/schema-json.json",
  "entry": ["src/index.html", "src/shim.ts"],
  "project": ["src/**/*.ts", "src/**/*.html", "*.config.ts"],
  "vite": true,
  "ignoreExportsUsedInFile": true,
  "rules": {
    "files": "warn",
    "dependencies": "warn",
    "devDependencies": "warn",
    "unlisted": "warn",
    "unresolved": "warn",
    "exports": "warn",
    "nsExports": "warn",
    "nsTypes": "warn",
    "enumMembers": "warn",
    "types": "warn"
  },
  "ignore": ["src/generated/**"],
  "ignoreDependencies": ["@lit/localize-tools"],
  "ignoreIssues": {
    "src/components/ui/index.ts": ["exports", "nsExports", "nsTypes", "types"],
    "src/components/ui/floating.ts": ["exports"],
    "src/components/ui/icon.ts": ["exports"],
    "src/styles/shared.ts": ["exports"],
    "src/styles/tokens.ts": ["exports"]
  }
}
